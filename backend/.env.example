# ── Aether AI Environment Configuration ──────────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# Google Gemini API Key (required, unless both models run in Ollama: see below)
GOOGLE_API_KEY=your_google_api_key_here

# Secret used to sign login tokens (required — the backend refuses to start without it).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_with_a_long_random_string

# Every other setting is optional. Each one is listed below, commented out, with its default;
# src/core/config.py says more about each. Environment variables win over this file.
#
# ── Models ────────────────────────────────────────────────────────────────────
# Models on this computer through Ollama instead of Gemini (README, "Models on your own computer"):
# AETHER_LLM_PROVIDER=ollama
# AETHER_EMBEDDING_PROVIDER=ollama       (then run python -m src.reembed --apply once, if you have documents)
# AETHER_LLM_MODEL=qwen3.5:4b            (an Ollama model name; this one is the default with Ollama)
# AETHER_EMBEDDING_MODEL=nomic-embed-text   (the default with Ollama; with Gemini: models/gemini-embedding-001)
# AETHER_OLLAMA_URL=http://127.0.0.1:11434
# AETHER_OLLAMA_NUM_CTX=8192             (tokens of context Ollama gives the chat model)
# AETHER_OLLAMA_THINK=false              (true lets a model that can think before it answers do so: slower)
# AETHER_OLLAMA_KEEP_ALIVE=30m           (how long Ollama keeps the model loaded after a question)
#
# Any service that speaks OpenAI's API (README, "Any OpenAI-compatible service"):
# AETHER_LLM_PROVIDER=openai
# AETHER_OPENAI_URL=https://api.groq.com/openai/v1   (LM Studio: http://localhost:1234/v1, Ollama: http://127.0.0.1:11434/v1)
# OPENAI_API_KEY=<the service's key; none for LM Studio or Ollama>
# AETHER_LLM_MODEL=<a model id the service lists: there is no default>
# AETHER_OPENAI_REASONING_EFFORT=none    (for a model that thinks before it answers, such as qwen3.5)
#
# With Gemini (the default provider):
# AETHER_LLM_MODEL=<another Gemini model id; the default is in src/core/config.py>
#
# For every provider:
# AETHER_LLM_TEMPERATURE=0.3
# AETHER_TOOL_TEMPERATURE=0.0            (the agent and the evaluation's judge)
# AETHER_LLM_TIMEOUT_SECONDS=120
# AETHER_LLM_MAX_ATTEMPTS=3              (a call refused for quota or availability is tried again, up to this many calls)
# AETHER_LLM_RETRY_SECONDS=2             (the wait before the second call; it doubles after that)
# AETHER_LLM_MAX_OUTPUT_TOKENS=8192
# AETHER_EMBEDDING_TIMEOUT_SECONDS=60
# AETHER_JUDGE_MODEL=<a model other than the one that answers; only the evaluation uses it>
#
# ── Reading documents ─────────────────────────────────────────────────────────
# AETHER_DOCUMENT_LOADER=native          (or langchain: LangChain's document loaders, Task 12)
# AETHER_OCR=false                       (do not read scanned PDF pages by OCR; on by default)
# AETHER_OCR_MAX_PAGES=100               (a file with more scanned pages than this is refused)
# AETHER_OCR_PAGES_PER_HOUR=200          (pages one user may have read by OCR in any hour)
# AETHER_CHUNK_SIZE=1000                 (characters in a passage)
# AETHER_CHUNK_OVERLAP=150               (characters a passage shares with the next)
#
# ── Answering ─────────────────────────────────────────────────────────────────
# AETHER_TOP_K=5                         (passages read for an answer)
# AETHER_CONFIDENCE_THRESHOLD=0.3        (a question whose best passage scores lower is refused)
# AETHER_GROUNDED_AT=0.5                 (the confidence at which an answer reads as grounded; set for each embedding model)
# AETHER_ANSWER_FROM=chunks              (or summary: the passages summarised first, then answered; two model calls)
# AETHER_CHUNK_WINDOW=1                  (passages either side of the two best hits read with them; 0: none)
# AETHER_RERANK_MODEL=                   (empty: no reranking; the default model is in src/core/config.py)
# AETHER_RERANK_CANDIDATES=20            (passages the search finds for the reranker to choose the best from)
# AETHER_MEMORY_MAX_TURNS=10             (turns of a conversation remembered)
# AETHER_AGENT_RECURSION_LIMIT=12        (steps the agent may take for one question; each tool call takes two)
#
# ── Sign-in ───────────────────────────────────────────────────────────────────
# AETHER_ACCESS_TOKEN_MINUTES=30
# AETHER_REFRESH_TOKEN_DAYS=7            (signing in again is needed after this long without use)
#
# ── Limits ────────────────────────────────────────────────────────────────────
# AETHER_MAX_UPLOAD_BYTES=52428800       (50 MB)
# AETHER_MAX_UNPACKED_BYTES=209715200    (200 MB: a Word or Excel file once unpacked)
# AETHER_MAX_TABLE_ROWS=100000           (rows across all the sheets of a CSV or Excel file)
# AETHER_MAX_CHUNKS_PER_DOCUMENT=5000
# AETHER_MAX_DOCUMENTS_PER_USER=100
# AETHER_MAX_QUESTION_CHARS=5000
# AETHER_RATE_LIMIT_DEFAULT=120/minute   (per user, on every route without a limit of its own)
# AETHER_RATE_LIMIT_REGISTER=5/minute
# AETHER_RATE_LIMIT_LOGIN=10/minute
# AETHER_RATE_LIMIT_UPLOAD=10/minute
# AETHER_RATE_LIMIT_CHAT=30/minute
#
# ── Where data is kept ────────────────────────────────────────────────────────
# AETHER_DB_PATH=C:\Projects\Aether-AI\data\aether.db
# AETHER_VECTOR_STORE_DIR=C:\Projects\Aether-AI\data\vector_store
# AETHER_FILES_DIR=C:\Projects\Aether-AI\data\files     (uploaded PDFs, kept to show their pages)
# AETHER_MODEL_DIR=C:\Projects\Aether-AI\data\models    (where the reranking model is downloaded)
# AETHER_LOG_DIR=C:\Projects\Aether-AI\backend\logs
#
# ── Before other people can reach the app (see README, "Running it where other people can reach it") ──
# AETHER_ENVIRONMENT=production          (turns off /docs, /redoc and /openapi.json)
# AETHER_INVITE_CODE=<a code you give to the people who may register; empty means anyone can>
# AETHER_COOKIE_SECURE=true              (only once the app is served over HTTPS)
# AETHER_ALLOWED_ORIGINS=["https://aether.example.org"]   (a JSON list of the addresses the app is opened at; the default allows ports 5173 and 8000 on this computer)
