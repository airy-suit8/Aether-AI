# ── Aether AI Environment Configuration ──────────────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# Google Gemini API Key (required, unless both models run in Ollama: see below)
GOOGLE_API_KEY=your_google_api_key_here

# Secret used to sign login tokens (required — the backend refuses to start without it).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_with_a_long_random_string

# Optional: any setting in src/core/config.py, with the AETHER_ prefix. Environment variables
# win over this file. Examples:
# AETHER_LLM_MODEL=<another Gemini model id; the default is in src/core/config.py>
#
# Models on this computer through Ollama instead of Gemini (README, "Models on your own computer"):
# AETHER_LLM_PROVIDER=ollama
# AETHER_EMBEDDING_PROVIDER=ollama       (then run python -m src.reembed --apply once, if you have documents)
# AETHER_LLM_MODEL=qwen3.5:4b            (an Ollama model name; this one is the default with Ollama)
#
# Any service that speaks OpenAI's API (README, "Any OpenAI-compatible service"):
# AETHER_LLM_PROVIDER=openai
# AETHER_OPENAI_URL=https://api.groq.com/openai/v1   (LM Studio: http://localhost:1234/v1, Ollama: http://127.0.0.1:11434/v1)
# OPENAI_API_KEY=<the service's key; none for LM Studio or Ollama>
# AETHER_LLM_MODEL=<a model id the service lists: there is no default>
# AETHER_OPENAI_REASONING_EFFORT=none    (for a model that thinks before it answers, such as qwen3.5)
#
# AETHER_TOP_K=5
# AETHER_CONFIDENCE_THRESHOLD=0.3
# AETHER_GROUNDED_AT=0.5                (the confidence at which an answer reads as grounded; set for each embedding model)
# AETHER_RERANK_MODEL=                  (empty: no reranking; the default model is in src/core/config.py)
# AETHER_MODEL_DIR=C:\Projects\Aether-AI\data\models   (where the reranking model is downloaded)
# AETHER_FILES_DIR=C:\Projects\Aether-AI\datailes     (uploaded PDFs, kept to show their pages)
# AETHER_DOCUMENT_LOADER=native        (or langchain: LangChain's document loaders, Task 12)
# AETHER_DB_PATH=C:\Projects\Aether-AI\data\aether.db
# AETHER_JUDGE_MODEL=<a model other than the one that answers; only the evaluation uses it>
#
# Before other people can reach the app (see README, "Running it where other people can reach it"):
# AETHER_ENVIRONMENT=production         (turns off /docs, /redoc and /openapi.json)
# AETHER_INVITE_CODE=<a code you give to the people who may register; empty means anyone can>
# AETHER_COOKIE_SECURE=true             (only once the app is served over HTTPS)
