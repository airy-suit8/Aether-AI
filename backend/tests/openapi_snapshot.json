    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Health check for monitoring and load balancers. Status only: it is public, so it says\nnothing about the version, the uptime or anyone's documents (S10).",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/upload": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upload Document",
        "description": "Upload a document: PDF, Word, text, Markdown, CSV or Excel. 202: it is accepted and read in\nthe background; GET /documents/{document_id} reports when it is ready or why it failed (R12).\n\nThe token is checked before any of the body is read (S4).",
        "operationId": "upload_document_api_v1_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "title": "File"
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ],
                "title": "Upload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
