    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh",
        "description": "A new access token for the refresh cookie set at sign-in. 401 when it is missing, expired,\nor names a user who is gone.",
        "operationId": "refresh_api_v1_auth_refresh_post",
