        "tags": [
          "Documents"
        ],
        "summary": "Delete One Document",
        "description": "Delete one document, by the id the detailed list gives it. 404 for an id that is not yours.",
        "operationId": "delete_one_document_api_v1_documents__document_id__delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
