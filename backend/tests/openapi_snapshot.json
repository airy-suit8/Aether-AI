      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get One Document",
        "description": "One document and how reading it went: \"processing\", then \"ready\" or \"failed\" with an error\n(R12). 404 for an id that is not yours. Declared after /documents/detailed, which it would\notherwise shadow.",
        "operationId": "get_one_document_api_v1_documents__document_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
